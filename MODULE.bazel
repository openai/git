module(
    name = "git",
    version = "0.0.0",
    bazel_compatibility = [">=8.5.0"],
)

bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "llvm", version = "0.8.24")
bazel_dep(name = "zlib-ng", version = "2.3.3.bcr.2")
bazel_dep(name = "zlib", version = "1.3.1.bcr.8")
bazel_dep(name = "pcre2", version = "10.46-DEV")
bazel_dep(name = "libexpat", version = "2.8.3")
bazel_dep(name = "openssl", version = "3.5.8.bcr.0")
bazel_dep(name = "nghttp2", version = "1.65.0.bcr.1")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# The registry overlay does not enable HTTP/2 or support the GNU Windows ABI.
# Keep this overlay in the module so it also applies when Git is a dependency.
http_archive(
    name = "curl",
    urls = ["https://github.com/curl/curl/releases/download/curl-8_22_0/curl-8.22.0.tar.gz"],
    integrity = "sha256-1U3VmL8Fknpybes43zHGolW6g/8d5XxdFGTaw+2PRKE=",
    strip_prefix = "curl-8.22.0",
    build_file = "//contrib/bazel/deps:curl.BUILD.bazel",
    patches = ["//contrib/bazel/deps:curl-config-win32.patch"],
    patch_args = ["-p1"],
)

http_archive(
    name = "win_iconv",
    urls = ["https://github.com/win-iconv/win-iconv/archive/refs/tags/v0.0.10.tar.gz"],
    sha256 = "58493387c7c9c70d61e711ec2feec5db0a59d164556642d2b427dde4ef756bc1",
    strip_prefix = "win-iconv-0.0.10",
    build_file = "//contrib/bazel/deps:win-iconv.BUILD.bazel",
)
