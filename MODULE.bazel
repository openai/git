module(name = "git_validation")

bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "llvm", version = "0.8.24")
bazel_dep(name = "zlib-ng", version = "2.3.3.bcr.2")
bazel_dep(name = "pcre2", version = "10.46-DEV")
bazel_dep(name = "libexpat", version = "2.7.1")
bazel_dep(name = "openssl", version = "3.5.5.bcr.4")
bazel_dep(name = "curl", version = "8.11.0.bcr.5")

single_version_override(
    module_name = "curl",
    version = "8.11.0.bcr.5",
    patch_strip = 1,
    patches = [
        "//contrib/bazel/validation:curl-public-static-symbols.patch",
        "//contrib/bazel/validation:curl-windows-gnu.patch",
    ],
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "win_iconv",
    urls = ["https://github.com/win-iconv/win-iconv/archive/refs/tags/v0.0.10.tar.gz"],
    sha256 = "58493387c7c9c70d61e711ec2feec5db0a59d164556642d2b427dde4ef756bc1",
    strip_prefix = "win-iconv-0.0.10",
    build_file_content = "load(\"@rules_cc//cc:cc_library.bzl\", \"cc_library\")\n\ncc_library(\n    name = \"win_iconv\",\n    srcs = [\"win_iconv.c\"],\n    hdrs = [\"iconv.h\", \"localcharset.h\"],\n    includes = [\".\"],\n    defines = [\"WINICONV_CONST=\"],\n    target_compatible_with = [\"@platforms//os:windows\"],\n    visibility = [\"//visibility:public\"],\n)\n",
)

http_archive(
    name = "git",
    urls = ["https://github.com/openai/git/archive/58288748e2dc44444704132b7ba647695053e8e8.tar.gz"],
    strip_prefix = "git-58288748e2dc44444704132b7ba647695053e8e8",
)
