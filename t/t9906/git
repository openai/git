#!/usr/bin/env bash
# Keep real Git storage and transactions, with transport confined to the
# fixture repositories. Only destination URL inspection is simulated.
set -euo pipefail
args=("$@")
for ((i=0; i<${#args[@]}; i++))
do
	case "${args[$i]}" in
	remote)
		if test "${args[$((i+1))]:-}" = get-url
		then printf '%s\n' "${RELEASE_TEST_ORIGIN:-https://github.com/example/distribution.git}"; exit
		fi ;;
	https://github.com/example/upstream.git) args[i]=$RELEASE_TEST_DIR/upstream.git ;;
	https://github.com/*|git@github.com:*) echo 'fixture refuses network Git transport' >&2; exit 99 ;;
	push)
		printf 'push\n' >>"$RELEASE_TEST_DIR/events"
		if test -f "$RELEASE_TEST_DIR/race"
		then
			"$RELEASE_REAL_GIT" --git-dir="$RELEASE_TEST_DIR/remote.git" update-ref refs/heads/meta "$(cat "$RELEASE_TEST_DIR/race")"
			rm "$RELEASE_TEST_DIR/race"
		fi ;;
	esac
done
exec "$RELEASE_REAL_GIT" "${args[@]}"
