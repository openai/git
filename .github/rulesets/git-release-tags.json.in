{
  "name": "Keep Git release tags immutable",
  "target": "tag",
  "source_type": "Repository",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/tags/*-openai.*"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "update"
    },
    {
      "type": "deletion"
    }
  ],
  "bypass_actors": []
}
