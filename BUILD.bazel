    name = "libgit",
    srcs = _CORE_SRCS + [
        "compat/fopen.c",
        "compat/qsort_s.c",
        "compat/strlcpy.c",
        "compat/simple-ipc/ipc-shared.c",
        "sha1dc_git.c",
        "sha1dc/sha1.c",
        "sha1dc/ubc_check.c",
        "sha256/block/sha256.c",
        "unix-socket.c",
        "unix-stream-server.c",
    ] + select({
        "@platforms//os:linux": [
            "compat/linux/procinfo.c",
            "compat/simple-ipc/ipc-unix-socket.c",
            "compat/fsmonitor/fsm-health-linux.c",
            "compat/fsmonitor/fsm-ipc-unix.c",
            "compat/fsmonitor/fsm-listen-linux.c",
            "compat/fsmonitor/fsm-path-utils-linux.c",
            "compat/fsmonitor/fsm-settings-unix.c",
        ],
        "@platforms//os:macos": [
            "compat/darwin/procinfo.c",
            "compat/memmem.c",
            "compat/precompose_utf8.c",
            "compat/regcomp_enhanced.c",
            "compat/simple-ipc/ipc-unix-socket.c",
            "compat/fsmonitor/fsm-health-darwin.c",
            "compat/fsmonitor/fsm-ipc-unix.c",
            "compat/fsmonitor/fsm-listen-darwin.c",
            "compat/fsmonitor/fsm-path-utils-darwin.c",
            "compat/fsmonitor/fsm-settings-unix.c",
        ],
        "@platforms//os:windows": [
            "compat/basename.c",
            "compat/memmem.c",
            "compat/mingw.c",
            "compat/poll/poll.c",
            "compat/pread.c",
            "compat/setenv.c",
            "compat/strcasestr.c",
            "compat/strtoimax.c",
            "compat/strtoumax.c",
            "compat/win32/dirent.c",
            "compat/win32/flush.c",
            "compat/win32/path-utils.c",
            "compat/win32/pthread.c",
            "compat/win32/syslog.c",
            "compat/win32/trace2_win32_process_info.c",
            "compat/win32mmap.c",
            "compat/winansi.c",
            "compat/writev.c",
            "compat/simple-ipc/ipc-win32.c",
            "compat/fsmonitor/fsm-health-win32.c",
            "compat/fsmonitor/fsm-ipc-win32.c",
            "compat/fsmonitor/fsm-listen-win32.c",
