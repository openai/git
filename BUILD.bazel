)

cc_library(
    name = "builtins",
    srcs = _BUILTIN_SRCS,
    copts = GIT_COPTS,
    deps = [":libgit"],
)

cc_library(
    name = "libgit_http",
    srcs = ["http.c", "http-walker.c"],
    copts = GIT_COPTS,
    deps = [":libgit", "@curl"],
)

genrule(
    name = "windows_resource_object",
    srcs = [":windows_resource_file", "compat/win32/git.manifest", "GIT-VERSION-GEN"],
    outs = ["git-resource.o"],
    cmd = """
      sed 's/RT_MANIFEST/24/' $(location :windows_resource_file) > "$(@D)/git-windres.rc"
      $(location @llvm//tools:llvm-windres) --input="$(@D)/git-windres.rc" --output="$@" \
        --output-format=coff --include-dir="$$(dirname $(location GIT-VERSION-GEN))" \
        --no-preprocess """ + select({
        "@platforms//cpu:x86_64": " --target=pe-x86-64",
        "@platforms//cpu:aarch64": " --target=aarch64-w64-mingw32",
    }),
    tools = ["@llvm//tools:llvm-windres"],
    target_compatible_with = ["@platforms//os:windows"],
    tags = ["manual"],
)

cc_library(
    name = "windows_resources",
    srcs = [":windows_resource_object"],
    alwayslink = True,
    target_compatible_with = ["@platforms//os:windows"],
    tags = ["manual"],
)

git_binary(name = "git", srcs = ["git.c"], deps = [":builtins"])
git_binary(name = "scalar", srcs = ["scalar.c"])
git_binary(name = "git-shell", srcs = ["shell.c"])
git_binary(name = "git-daemon", srcs = ["daemon.c"])
git_binary(name = "git-http-backend", srcs = ["http-backend.c"])
git_binary(name = "git-http-fetch", srcs = ["http-fetch.c"], deps = [":libgit_http"])
git_binary(name = "git-http-push", srcs = ["http-push.c"], deps = [":libgit_http", "@libexpat"])
git_binary(name = "git-imap-send", srcs = ["imap-send.c"], deps = [":libgit_http"])
git_binary(name = "git-remote-http", srcs = ["remote-curl.c"], deps = [":libgit_http"])
git_binary(name = "git-sh-i18n--envsubst", srcs = ["sh-i18n--envsubst.c"])

filegroup(
    name = "templates",
    srcs = glob(["templates/hooks/*.sample"]) + ["templates/description", "templates/info/exclude"],
)

filegroup(name = "mergetools", srcs = glob(["mergetools/*"]))
